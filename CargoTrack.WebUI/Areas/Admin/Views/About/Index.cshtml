
@model List<ResultAboutDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>Hakkımızda</h3>

@if (!Model.Any())
{
    <div class="alert alert-info">Henüz Hakkımızda Bilgisi Oluşturulmamış</div>
    <br />
    <a href="/Admin/About/Create" class="btn btn-dark">Yeni Hakkımızda Oluştur</a>

}

else
{
    <table class="table table-bordered table-hover">

     
        <tr>
            <th>Görsel</th>
            <th>Başlık</th>
            <th>Açıklama</th>
            <th>İşlemler</th>
        </tr>

        @foreach (var item in Model)
        {
       
            <tr>
                <td><img src="@item.ImageUrl" style="height:75px;width:75px;border-radius:50%" /></td>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>
                    <a href="/Admin/About/Delete/@item.Id" onclick="return confirm('Silmek istediğinize emin misiniz?')" class="btn btn-danger">Sil</a>
                    <a href="/Admin/About/Update/@item.Id" class="btn btn-info">Güncelle</a>

                </td>
            </tr>
        }

    </table>
}






